# Copy to .env with:  python3 scripts/gen-secrets.py    (generates every CHANGE_ME value)
APP_ENV=production
LOG_LEVEL=info

# Where the app is reached from outside (used for WebAuthn, links in emails, Telegram webhook URL)
PUBLIC_URL=http://localhost:8088
PUBLIC_PORT=8088
# Address your iPhone uses to reach this machine on your Wi-Fi (shown in the Setup guide). Not used for sign-in or passkeys,
# which need PUBLIC_URL to be a real host name (passkeys do not work on an IP address).
PHONE_URL=http://YOUR-MAC-IP:8088
# Gateway published on 127.0.0.1 only (scripts/e2e.py talks to it)
GATEWAY_PORT=3010

# Image names are ${REGISTRY}budget-<name>:${IMAGE_TAG}. Set REGISTRY (with trailing slash) to push to a registry.
REGISTRY=
IMAGE_TAG=latest

# Postgres: one instance, one schema and one login role per service (see packages/bt/src/bt/db/bootstrap.py)
POSTGRES_USER=bt_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=budget
DB_PASSWORD_QUEUE=CHANGE_ME
DB_PASSWORD_AUTH=CHANGE_ME
DB_PASSWORD_LEDGER=CHANGE_ME
DB_PASSWORD_INGEST=CHANGE_ME
DB_PASSWORD_PLANNING=CHANGE_ME
DB_PASSWORD_RECURRING=CHANGE_ME
DB_PASSWORD_TELEGRAM=CHANGE_ME

# Secrets shared by services (never commit real values)
INTERNAL_SECRET=CHANGE_ME
ACCESS_TOKEN_SECRET=CHANGE_ME
# 32 random bytes, base64. Encrypts TOTP secrets, unreadable messages and the bot token. Back it up.
FIELD_KEY=CHANGE_ME

# One account per install by default. Set to "open" to allow more sign-ups (the e2e script does).
REGISTRATION=first-only
# Email (only used for the e-mail change link). log = print the link in the auth log (non-production only); smtp = send.
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=
