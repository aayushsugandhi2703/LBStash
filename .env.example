# ============================================================================
# 1. APP
# ============================================================================
# Copy to .env with:  python3 scripts/gen-secrets.py    (it generates every CHANGE_ME value)
APP_ENV=production
LOG_LEVEL=info

# ============================================================================
# 2. PUBLIC ADDRESS
# ============================================================================
# Where the app is reached from outside (used for WebAuthn, links in emails, Telegram webhook URL).
# Local: http://localhost:8088   Live: https://<DOMAIN>
PUBLIC_URL=http://localhost:8088
# Port of the Caddy `proxy` on this machine.
PUBLIC_PORT=8088
# Gateway published on 127.0.0.1 only (scripts/e2e.py talks to it).
GATEWAY_PORT=3010

# ============================================================================
# 3. HTTPS ON YOUR OWN DOMAIN (nginx + Let's Encrypt)
# ============================================================================
# Started by `docker compose up -d`. Once DNS for DOMAIN points at this machine and ports 80 and 443 are open:
# set LETSENCRYPT_EMAIL and PUBLIC_URL=https://<DOMAIN>, then `docker compose up -d`.
# Using the Cloudflare Tunnel (section 4) instead? Leave LETSENCRYPT_EMAIL empty.
DOMAIN=aegios.co.in
LETSENCRYPT_EMAIL=
# 1 = Let's Encrypt test certificate (dry run; then delete nginx/certs and set 0).
LETSENCRYPT_STAGING=0
HTTP_PORT=80
HTTPS_PORT=443

# ============================================================================
# 4. CLOUDFLARE TUNNEL
# ============================================================================
# Use this when the machine is at home or has no public IP. Cloudflare supplies the https certificate.
# Cloudflare Zero Trust > Networks > Tunnels > create a tunnel, copy its token here,
# and set the public hostname to DOMAIN -> http://nginx:80.
TUNNEL_TOKEN=paste-the-token-here
# Set to `tunnel` so a plain `docker compose up -d` starts the tunnel.
COMPOSE_PROFILES=

# ============================================================================
# 5. DOCKER IMAGES
# ============================================================================
# Image names are ${REGISTRY}budget-<name>:${IMAGE_TAG}. Set REGISTRY (with trailing slash) to push to a registry.
REGISTRY=
IMAGE_TAG=latest

# ============================================================================
# 6. DATABASE (PostgreSQL)
# ============================================================================
# One instance, one schema and one login role per service (see packages/bt/src/bt/db/bootstrap.py).
POSTGRES_USER=bt_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=budget
DB_PASSWORD_QUEUE=CHANGE_ME
DB_PASSWORD_AUTH=CHANGE_ME
DB_PASSWORD_LEDGER=CHANGE_ME
DB_PASSWORD_INGEST=CHANGE_ME
DB_PASSWORD_PLANNING=CHANGE_ME
DB_PASSWORD_RECURRING=CHANGE_ME
DB_PASSWORD_TELEGRAM=CHANGE_ME

# ============================================================================
# 7. SECRETS SHARED BY SERVICES
# ============================================================================
# Never commit real values.
INTERNAL_SECRET=CHANGE_ME
ACCESS_TOKEN_SECRET=CHANGE_ME
# 32 random bytes, base64. Encrypts TOTP secrets, unreadable messages and the bot token. BACK IT UP.
FIELD_KEY=CHANGE_ME

# ============================================================================
# 8. SIGN-UP
# ============================================================================
# One account per install by default. Set to "open" to allow more sign-ups (the e2e script does).
REGISTRATION=first-only

# ============================================================================
# 9. EMAIL (welcome mail after sign-up, e-mail change link)
# ============================================================================
# MAIL_TRANSPORT: log = print the mail in the auth log (non-production only), smtp = really send.
# SMTP_URL:  smtps://<user>:<app-password>@<host>:465   (or smtp://...:587 for STARTTLS).
#            Write @ inside the user name as %40. Gmail needs an App Password, not your login password.
MAIL_TRANSPORT=log
# Example: smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465
SMTP_URL=
# Example: Ledger <you@gmail.com>   (empty = Ledger <no-reply@PUBLIC_URL host>)
MAIL_FROM=
