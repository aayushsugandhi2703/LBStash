# Used until the certificate exists (or when LETSENCRYPT_EMAIL is not set): answers Let's Encrypt's challenge and serves the app over http.

include /etc/nginx/snippets/common.conf;

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/snippets/app-routes.conf;
}
